{
  "slug": "paper-explainer",
  "name": "Paper Explainer",
  "domain": "Education / Research",
  "target_user": "Domain operator, business owner, analyst, or team member who needs this workflow executed reliably.",
  "core_job": "Paper/DOI/PDF → understandable explanation",
  "deep_features": [
    "figure-aware summary",
    "methods critique",
    "limitations",
    "glossary",
    "citation context",
    "replication checklist",
    "related papers",
    "audience modes"
  ],
  "input_schema": [
    {
      "key": "paper",
      "label": "Paper",
      "type": "text",
      "required": true,
      "help": "Affects input: Paper.",
      "affects": [
        "prompt",
        "workflow"
      ],
      "default": ""
    },
    {
      "key": "doi",
      "label": "DOI",
      "type": "text",
      "required": true,
      "help": "Affects input: DOI.",
      "affects": [
        "prompt",
        "workflow"
      ],
      "default": ""
    },
    {
      "key": "pdf",
      "label": "PDF",
      "type": "text",
      "required": true,
      "help": "Affects input: PDF.",
      "affects": [
        "prompt",
        "workflow"
      ],
      "default": ""
    },
    {
      "key": "work_brief",
      "label": "Work brief / source text / URL / instructions",
      "type": "textarea",
      "required": true,
      "default": "",
      "help": "Paste the material, URL, description, or instruction needed for this project.",
      "affects": [
        "prompt",
        "workflow"
      ]
    }
  ],
  "customization_schema": [
    {
      "key": "execution_mode",
      "label": "Execution mode",
      "type": "select",
      "required": false,
      "options": [
        "Draft",
        "Production",
        "Audit / strict review",
        "JSON/API output"
      ],
      "default": "Production",
      "help": "Controls strictness, depth, and output format for this project workflow.",
      "affects": [
        "workflow",
        "validation",
        "export"
      ]
    },
    {
      "key": "field",
      "label": "field",
      "type": "text",
      "required": false,
      "help": "Affects customization: field.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "default": ""
    },
    {
      "key": "audience_level",
      "label": "audience level",
      "type": "select",
      "required": false,
      "help": "Affects customization: audience level.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "options": [
        "general",
        "executive",
        "technical",
        "legal",
        "medical",
        "student",
        "customer"
      ],
      "default": "general"
    },
    {
      "key": "output_depth",
      "label": "output depth",
      "type": "text",
      "required": false,
      "help": "Affects customization: output depth.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "default": ""
    },
    {
      "key": "citation_style",
      "label": "citation style",
      "type": "select",
      "required": false,
      "help": "Affects customization: citation style.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "options": [
        "APA",
        "Vancouver",
        "MLA",
        "Chicago",
        "None"
      ],
      "default": "APA"
    },
    {
      "key": "focus_section",
      "label": "focus section",
      "type": "text",
      "required": false,
      "help": "Affects customization: focus section.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "default": ""
    },
    {
      "key": "language",
      "label": "language",
      "type": "select",
      "required": false,
      "help": "Affects customization: language.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "options": [
        "English",
        "Arabic",
        "Egyptian Arabic",
        "French",
        "German",
        "Spanish"
      ],
      "default": "English"
    },
    {
      "key": "critique_strictness",
      "label": "critique strictness",
      "type": "slider",
      "required": false,
      "help": "Affects customization: critique strictness.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "min": 0,
      "max": 100,
      "default": 50
    },
    {
      "key": "output_format",
      "label": "output format",
      "type": "select",
      "required": false,
      "help": "Affects customization: output format.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "options": [
        "Markdown",
        "JSON",
        "CSV",
        "PDF",
        "DOCX",
        "XLSX"
      ],
      "default": "Markdown"
    },
    {
      "key": "privacy_mode",
      "label": "privacy mode",
      "type": "select",
      "required": false,
      "help": "Affects customization: privacy mode.",
      "affects": [
        "prompt",
        "validation",
        "workflow",
        "export"
      ],
      "options": [
        "cloud allowed",
        "local only",
        "redact sensitive data"
      ],
      "default": "cloud allowed"
    },
    {
      "key": "confidence_threshold",
      "label": "Confidence threshold",
      "type": "slider",
      "required": false,
      "min": 0,
      "max": 100,
      "default": 75,
      "help": "Items below this confidence are escalated to the human review queue.",
      "affects": [
        "validation",
        "workflow",
        "export"
      ]
    }
  ],
  "workflow_steps": [
    "Paper/DOI/PDF",
    "understandable explanation"
  ],
  "ui_panels": [
    "paper viewer",
    "summary tabs",
    "figure/claim cards",
    "glossary",
    "quiz/export"
  ],
  "output_formats": [
    "plain-English summary",
    "glossary",
    "critique",
    "citation export"
  ],
  "integrations": [
    "File upload",
    "REST API",
    "Export download",
    "Job history",
    "DOI/PubMed/Crossref optional"
  ],
  "guardrails": [
    "Show uncertainty and confidence",
    "Cite evidence from input when possible",
    "Human review required for legal, medical, financial, hiring, or security decisions",
    "Do not invent facts absent from input"
  ],
  "recommended_models": {
    "drafting": "fast cloud or local instruct model",
    "reasoning": "strong reasoning model",
    "private_documents": "local model via Ollama/LM Studio/vLLM",
    "vision_or_pdf": "vision-capable model when image pages are used"
  },
  "suite": "Medical & Research Suite",
  "implementation_status": "real_local_engine_registered",
  "analysis_modules": [
    "paper_structure",
    "plain_language_summary",
    "flashcard_generate"
  ],
  "output_sections": [
    "Plain summary",
    "Methods map",
    "Limitations",
    "Study cards"
  ],
  "field_validations": [
    {
      "field": "language",
      "rule": "Preserve requested language in final deliverable unless source text requires bilingual output."
    },
    {
      "field": "critique_strictness",
      "rule": "Use selected risk tolerance to adjust severity labels and escalation threshold."
    }
  ],
  "scorecards": [
    "Evidence confidence",
    "Safety risk",
    "Coding certainty",
    "PHI risk",
    "Human-review priority"
  ],
  "automation_hooks": [
    {
      "name": "save_job_snapshot",
      "type": "internal",
      "description": "Persist inputs, customization, uploads, output, and usage for audit/history."
    },
    {
      "name": "export_pack",
      "type": "internal",
      "description": "Export Markdown, JSON, PDF, and DOCX from the completed job."
    },
    {
      "name": "human_review_queue",
      "type": "manual",
      "description": "Flag low-confidence, legal/medical/finance/security/compliance-sensitive items for human review."
    }
  ],
  "ux_profile": {
    "name": "Evidence & Safety Workbench",
    "accent": "#5eead4",
    "layout": "Source intake → evidence extraction → safety review → study/learning output",
    "hero": "Medical/research-safe workspace with citations, evidence grids, warning panels, and human-review gates.",
    "components": [
      "Evidence extraction table",
      "Citation manager",
      "Clinical safety warnings",
      "Study/learning map",
      "Human review checklist"
    ],
    "metrics": [
      "Evidence completeness",
      "Citation coverage",
      "Safety flags",
      "Review readiness"
    ],
    "quick_actions": [
      "Extract evidence",
      "Build citation list",
      "Check safety warnings",
      "Create study outputs"
    ],
    "review_lanes": [
      "Collect",
      "Extract",
      "Verify",
      "Review",
      "Export"
    ],
    "empty_state": "Paste paper text, notes, or upload source files. Clinical/medical decisions require expert verification.",
    "icon": "🩺",
    "project_slug": "paper-explainer",
    "domain": "Education / Research"
  },
  "final_gui_status": {
    "standalone_folder_gui": true,
    "domain_specific_ux_profile": true,
    "elegant_component_system": true,
    "no_fake_live_data_policy": true,
    "requires_real_connectors_for_external_actions": true
  }
}